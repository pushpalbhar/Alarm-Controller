`timescale 1ns / 1ps
//////////////////////////////////////////////////////////////////////////////////
// Module Name : clock_generator   ("Timing Generator" in the top schematic)
// Project     : DIGITAL ALARM CLOCK
// Description : Divides the system clock down into two single-cycle-wide
//               tick pulses:
//                 one_second : pulses once every real second
//                 one_minute : pulses once every real minute (i.e. once
//                              every 60 one_second pulses)
//
//               `stopwatch` is a test/fast-forward mode: when high, the
//               divider uses FAST_DIV clock cycles per "second" instead of
//               CLK_FREQ_HZ, so the clock can be exercised in a short
//               testbench/simulation instead of waiting a full real second
//               per tick. Tie stopwatch = 0 for normal real-time operation
//               on hardware.
//////////////////////////////////////////////////////////////////////////////////

module clock_generator #(
    parameter CLK_FREQ_HZ = 50_000_000,  // system clock frequency -> defines 1 real second
    parameter FAST_DIV    = 4            // clk cycles per "second" when stopwatch = 1
)(
    input  clk,
    input  reset,
    input  stopwatch,       // 1 = fast test mode, 0 = real-time mode
    output reg one_second,
    output reg one_minute
);

reg [31:0] sec_count;
reg [5:0]  min_count;

wire [31:0] sec_limit = stopwatch ? FAST_DIV[31:0] : CLK_FREQ_HZ[31:0];

// ---- one_second generator ----
always @(posedge clk or posedge reset) begin
    if (reset) begin
        sec_count  <= 32'd0;
        one_second <= 1'b0;
    end
    else if (sec_count >= sec_limit - 1'b1) begin
        sec_count  <= 32'd0;
        one_second <= 1'b1;          // single-cycle pulse
    end
    else begin
        sec_count  <= sec_count + 1'b1;
        one_second <= 1'b0;
    end
end

// ---- one_minute generator (counts 60 one_second pulses) ----
always @(posedge clk or posedge reset) begin
    if (reset) begin
        min_count  <= 6'd0;
        one_minute <= 1'b0;
    end
    else if (one_second) begin
        if (min_count == 6'd59) begin
            min_count  <= 6'd0;
            one_minute <= 1'b1;      // single-cycle pulse
        end
        else begin
            min_count  <= min_count + 1'b1;
            one_minute <= 1'b0;
        end
    end
    else begin
        one_minute <= 1'b0;
    end
end

endmodule
