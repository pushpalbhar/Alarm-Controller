module alarm_clock_top #(
    parameter CLK_FREQ_HZ = 50_000_000
)(
    input  clk,
    input  reset,
    input  stopwatch,        // 1 = fast test mode for clock_generator, 0 = real time
    input  alarm_button,
    input  time_button,
    input  [3:0] key,        // 0-9 = digit pressed, 10 (NOKEY) = no key pressed

    output sound_alarm,
    output [7:0] display_ms_hr,
    output [7:0] display_ls_hr,
    output [7:0] display_ms_min,
    output [7:0] display_ls_min
);

    // ---------------- internal wires ----------------
    wire one_second, one_minute;
    wire load_new_a, show_a, show_new_time, load_new_c, shift;
    wire ctrl_reset_count;  // unused status wire, see NOTE above

    wire [3:0] key_buffer_ms_hr, key_buffer_ls_hr, key_buffer_ms_min, key_buffer_ls_min;
    wire [3:0] current_time_ms_hr, current_time_ls_hr, current_time_ms_min, current_time_ls_min;
    wire [3:0] alarm_time_ms_hr, alarm_time_ls_hr, alarm_time_ms_min, alarm_time_ls_min;

    wire sound_alarm_hr_ms, sound_alarm_hr_ls, sound_alarm_min_ms, sound_alarm_min_ls;

    // ---------------- Timing Generator ----------------
    clock_generator #(
        .CLK_FREQ_HZ(CLK_FREQ_HZ)
    ) u_clock_generator (
        .clk        (clk),
        .reset      (reset),
        .stopwatch  (stopwatch),
        .one_second (one_second),
        .one_minute (one_minute)
    );

    // ---------------- Alarm Controller (FSM) ----------------
    control_unit u_control_unit (
        .clock         (clk),
        .reset         (reset),
        .one_second    (one_second),
        .time_button   (time_button),
        .alarm_button  (alarm_button),
        .key           (key),
        .load_new_a    (load_new_a),
        .show_a        (show_a),
        .show_new_time (show_new_time),
        .load_new_c    (load_new_c),
        .shift         (shift),
        .reset_count   (ctrl_reset_count)
    );

    // ---------------- Key Register (digit entry shift register) ----------------
    key_register u_key_register (
        .clk               (clk),
        .reset             (reset),
        .shift             (shift),
        .key               (key),
        .key_buffer_ms_hr  (key_buffer_ms_hr),
        .key_buffer_ls_hr  (key_buffer_ls_hr),
        .key_buffer_ms_min (key_buffer_ms_min),
        .key_buffer_ls_min (key_buffer_ls_min)
    );

    // ---------------- Current-time Counter ----------------
    counter u_counter (
        .clk                     (clk),
        .reset                   (reset),
        .one_minute              (one_minute),
        .load_new_c              (load_new_c),
        .new_current_time_ms_hr  (key_buffer_ms_hr),
        .new_current_time_ls_hr  (key_buffer_ls_hr),
        .new_current_time_ms_min (key_buffer_ms_min),
        .new_current_time_ls_min (key_buffer_ls_min),
        .current_time_ms_hr      (current_time_ms_hr),
        .current_time_ls_hr      (current_time_ls_hr),
        .current_time_ms_min     (current_time_ms_min),
        .current_time_ls_min     (current_time_ls_min)
    );

    // ---------------- Alarm Register ----------------
    Alarm_register u_alarm_register (
        .new_alarm_ms_hr   (key_buffer_ms_hr),
        .new_alarm_ls_hr   (key_buffer_ls_hr),
        .new_alarm_ms_min  (key_buffer_ms_min),
        .new_alarm_ls_min  (key_buffer_ls_min),
        .load_new_alarm    (load_new_a),
        .clk               (clk),
        .reset             (reset),
        .alarm_time_ms_hr  (alarm_time_ms_hr),
        .alarm_time_ls_hr  (alarm_time_ls_hr),
        .alarm_time_ms_min (alarm_time_ms_min),
        .alarm_time_ls_min (alarm_time_ls_min)
    );

    // ---------------- Display Drivers (one per digit) ----------------
    display_driver u_disp_ms_hr (
        .key           (key_buffer_ms_hr),
        .alarm_time    (alarm_time_ms_hr),
        .current_time  (current_time_ms_hr),
        .show_alarm    (show_a),
        .show_new_time (show_new_time),
        .display_time  (display_ms_hr),
        .sound_alarm   (sound_alarm_hr_ms)
    );

    display_driver u_disp_ls_hr (
        .key           (key_buffer_ls_hr),
        .alarm_time    (alarm_time_ls_hr),
        .current_time  (current_time_ls_hr),
        .show_alarm    (show_a),
        .show_new_time (show_new_time),
        .display_time  (display_ls_hr),
        .sound_alarm   (sound_alarm_hr_ls)
    );

    display_driver u_disp_ms_min (
        .key           (key_buffer_ms_min),
        .alarm_time    (alarm_time_ms_min),
        .current_time  (current_time_ms_min),
        .show_alarm    (show_a),
        .show_new_time (show_new_time),
        .display_time  (display_ms_min),
        .sound_alarm   (sound_alarm_min_ms)
    );

    display_driver u_disp_ls_min (
        .key           (key_buffer_ls_min),
        .alarm_time    (alarm_time_ls_min),
        .current_time  (current_time_ls_min),
        .show_alarm    (show_a),
        .show_new_time (show_new_time),
        .display_time  (display_ls_min),
        .sound_alarm   (sound_alarm_min_ls)
    );

    // Whole-time match: alarm rings only when ALL 4 digits match
    assign sound_alarm = sound_alarm_hr_ms & sound_alarm_hr_ls &
                          sound_alarm_min_ms & sound_alarm_min_ls;

endmodule
